generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================
//        USER
// =============================
model User {
  id        String  @id @default(uuid())

  firstName String?
  lastName  String?
  email     String  @unique
  phone     String? @unique

  profileImage String?
  coverImage   String?
  bio       String?
  gender    String?
  birthDate DateTime?

  password  String
  role      Role    @default(user)

  isActive  Boolean @default(true)
  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)

  lastLoginAt DateTime?

  country  String? @default("DRC")
  city     String? @default("Kinshasa")
  address  String?

  companyName String?
  companyId   String?

  // =====================
  // RELATIONS
  // =====================
  properties Property[]
  bookings   Booking[]
  tenantBookings Booking[] @relation("BookingTenant")

  leasesAsTenant Lease[] @relation("TenantLeases")
  leasesAsOwner  Lease[] @relation("OwnerLeases")

  notifications Notification[]
  validatedBookings Booking[] @relation("BookingValidator")

  createdContracts Contract[] @relation("ContractCreator")
  contractUser     Contract[] @relation("ContractUser")

  reviews   Review[]
  favorites Favorite[]

  refreshTokens RefreshToken[]
  adminActionLogs AdminActionLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@index([city])
}

// =============================
//        PROPERTY
// =============================
model Property {
  id      String @id @default(uuid())
  userId  String
  slug    String @unique

  title            String
  shortDescription String?
  description      String?

  propertyType PropertyType @default(APARTMENT)

  price     Decimal @db.Decimal(12, 2)
  priceUnit PriceUnit @default(PER_MONTH)
  currency  Currency @default(CDF)

  status  PropertyStatus  @default(available)
  purpose PropertyPurpose @default(A_LOUER)

  bedrooms  Int?
  beds      Int?
  bathrooms Int?
  kitchens  Int?
  livingRooms Int?
  otherRooms Int?
  maxGuests Int?

  landSize Decimal? @db.Decimal(12, 2)
  
  securityDepositMonths Int? @default(1)
  commissionMonths Int? @default(1)
  commissionPercentage Decimal? @db.Decimal(5, 2)
  
  discount Decimal? @db.Decimal(5, 2)
  paymentType String?
  specialNotes String?

  isFeatured Boolean @default(false)
  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  bookings  Booking[]
  leases    Lease[]

  images    PropertyImage[]
  address   PropertyAddress?
  amenities PropertyAmenity[]
  reviews   Review[]
  favorites Favorite[]
  temporaryBlocks TemporaryBlock[]

  @@index([userId])
  @@index([status])
}

// =============================
//        PROPERTY IMAGE
// =============================
model PropertyImage {
  id         String @id @default(uuid())
  propertyId String
  imageUrl   String
  isPrimary  Boolean @default(false)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// =============================
//        PROPERTY ADDRESS
// =============================
model PropertyAddress {
  id         String @id @default(uuid())
  propertyId String @unique

  commune  String
  quartier String
  avenue   String
  number   String?
  city     String? @default("Kinshasa")
  province String? @default("Kinshasa")
  latitude Float?
  longitude Float?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// =============================
//        AMENITY
// =============================
model Amenity {
  id   String @id @default(uuid())
  name String @unique

  properties PropertyAmenity[]
}

// =============================
//        PROPERTY AMENITY
// =============================
model PropertyAmenity {
  id         String @id @default(uuid())
  propertyId String
  amenityId  String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
}

// =============================
//        REVIEW
// =============================
model Review {
  id         String @id @default(uuid())
  propertyId String
  userId     String

  rating  Int
  comment String?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([propertyId, userId])
}

// =============================
//        FAVORITE
// =============================
model Favorite {
  id         String @id @default(uuid())
  propertyId String
  userId     String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([propertyId, userId])
}

// =============================
//        BOOKING
// =============================
model Booking {
  id String @id @default(uuid())

  propertyId String
  userId     String
  tenantId   String?

  startDate DateTime
  endDate   DateTime
  nights    Int

  status BookingStatus @default(pending)

  totalAmount Decimal @db.Decimal(12, 2)

  validatedById String?
  validatedAt   DateTime?

  property Property @relation(fields: [propertyId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  tenant   User?    @relation("BookingTenant", fields: [tenantId], references: [id])

  validatedBy User? @relation("BookingValidator", fields: [validatedById], references: [id])

  lease Lease?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([userId])
  @@index([tenantId])
}

// =============================
//        LEASE (COEUR)
// =============================
model Lease {
  id String @id @default(uuid())

  bookingId String? @unique

  propertyId String
  tenantId   String
  ownerId    String

  startDate DateTime
  endDate   DateTime?

  rentAmount Decimal  @db.Decimal(12, 2)
  currency   Currency @default(USD)
  deposit    Decimal? @db.Decimal(12, 2)

  status LeaseStatus @default(active)

  property Property @relation(fields: [propertyId], references: [id])
  booking  Booking? @relation(fields: [bookingId], references: [id])

  tenant User @relation("TenantLeases", fields: [tenantId], references: [id])
  owner  User @relation("OwnerLeases", fields: [ownerId], references: [id])

  contract Contract?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([ownerId])
}

// =============================
//        CONTRACT
// =============================
model Contract {
  id      String @id @default(uuid())
  leaseId String @unique
  fileUrl String

  createdBy String
  userId    String?

  signedAt  DateTime?

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  creator User  @relation("ContractCreator", fields: [createdBy], references: [id])
  user    User? @relation("ContractUser", fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// =============================
//        NOTIFICATION
// =============================
model Notification {
  id     String @id @default(uuid())
  userId String

  title   String
  message String
  type    String?
  data    Json?

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// =============================
//        REFRESH TOKEN
// =============================
model RefreshToken {
  id     String @id @default(uuid())
  token  String @unique
  userId String

  expiresAt DateTime
  isRevoked Boolean @default(false)
  userAgent String?
  ipAddress String?
  replacedBy String?
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =============================
//        ENUMS
// =============================
enum Role {
  admin
  user
  owner
  tenant
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  BUILDING
  LAND
}

enum PropertyStatus {
  available
  reserved
  rented
}

enum PropertyPurpose {
  A_LOUER
  A_VENDRE
}

enum PriceUnit {
  PER_MONTH
}

enum BookingStatus {
  pending
  confirmed
  rejected
  cancelled
}

enum LeaseStatus {
  active
  terminated
  expired
}

enum Currency {
  USD
  CDF
  EUR
}


// =============================
//        ADMIN ACTION LOG
// =============================
model AdminActionLog {
  id        String @id @default(uuid())
  adminId   String
  action    String
  entity    String
  entityId  String?
  entityType String?
  description String?
  details   Json?
  
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])
}

// =============================
//        TEMPORARY BLOCK
// =============================
model TemporaryBlock {
  id         String @id @default(uuid())
  propertyId String
  startDate  DateTime
  endDate    DateTime
  expiresAt  DateTime
  sessionId  String?
  reason     String?
  
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

