generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================
//        USER MODEL
// =============================
model User {
  id            String      @id @default(uuid())
  firstName     String?     @map("first_name")
  middleName    String?     @map("middle_name")
  lastName      String?     @map("last_name")
  email         String      @unique
  phone         String?     @unique
  password      String?
  profileImage  String?     @map("profile_image")
  role          Role        @default(tenant)
  passwordChangedAt DateTime? @map("password_changed_at")
  failedLoginAttempts Int     @default(0) @map("failed_login_attempts")
  lockedUntil   DateTime?   @map("locked_until")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at")

  // Relations
  properties    Property[]
  bookings      Booking[]
  reviews       Review[]
  favorites     Favorite[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// =============================
//        ADDRESS MODEL
// =============================
model Address {
  id        String   @id @default(uuid())
  commune   String
  quartier  String
  avenue    String
  number    String?
  city      String   @default("Kinshasa")
  province  String   @default("Kinshasa")
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  properties Property[]

  @@map("addresses")
}

// =============================
//        PROPERTY MODEL
// =============================
model Property {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  addressId       String          @map("address_id")
  title           String
  slug            String          @default("temp-slug")
  shortDescription String?        @map("short_description")
  description     String?
  propertyType    PropertyType
  price           Decimal         @db.Decimal(12, 2)
  priceUnit       PriceUnit      @default(journalier) @map("price_unit")
  currency        Currency        @default(USD)
  status          PropertyStatus  @default(available)
  purpose         PropertyPurpose @default(A_LOUER)
  maxGuests       Int?
  bedrooms        Int?
  beds            Int?
  bathrooms       Int?
  kitchens        Int?
  livingRooms     Int?
  otherRooms      String?
  isFeatured      Boolean         @default(false) @map("is_featured")
  isVerified      Boolean         @default(false) @map("is_verified")
  views           Int             @default(0)
  discount        Int?            @default(0)
  paymentType     String?         @map("payment_type")
  specialNotes    String?         @map("special_notes")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Relations
  user            User            @relation(fields: [userId], references: [id])
  address         Address         @relation(fields: [addressId], references: [id])
  images          PropertyImage[]
  bookings        Booking[]
  reviews         Review[]
  favorites       Favorite[]
  amenities       PropertyAmenity[]

  @@map("properties")
}

// =============================
//        PROPERTY IMAGE
// =============================
model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  imageUrl   String   @map("image_url")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  property   Property @relation(fields: [propertyId], references: [id])

  @@map("property_images")
}

// =============================
//        BOOKING MODEL
// =============================
model Booking {
  id           String        @id @default(uuid())
  propertyId   String        @map("property_id")
  userId       String        @map("user_id")
  startDate    DateTime      @map("start_date")
  endDate      DateTime      @map("end_date")
  status       BookingStatus @default(pending)
  totalAmount  Decimal       @db.Decimal(12, 2) @map("total_amount")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relations
  property     Property @relation(fields: [propertyId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@map("bookings")
}

// =============================
//        REVIEW MODEL
// =============================
model Review {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  userId     String   @map("user_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  property   Property @relation(fields: [propertyId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@map("reviews")
}

// =============================
//        FAVORITE MODEL
// =============================
model Favorite {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  propertyId String   @map("property_id")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user       User     @relation(fields: [userId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id])

  @@map("favorites")
}

// =============================
//        REFRESH TOKEN MODEL
// =============================
model RefreshToken {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  token        String   @unique
  expiresAt    DateTime @map("expires_at")
  isRevoked    Boolean  @default(false) @map("is_revoked")
  replacedBy   String?  @map("replaced_by")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")

  // Relations
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@index([userId])
  @@index([token])
}

// =============================
//        AMENITY MODEL
// =============================
model Amenity {
  id        String      @id @default(uuid())
  name      String      @unique
  properties PropertyAmenity[]
}

model PropertyAmenity {
  id         String    @id @default(uuid())
  property   Property  @relation(fields: [propertyId], references: [id])
  propertyId String
  amenity    Amenity   @relation(fields: [amenityId], references: [id])
  amenityId  String
}

// =============================
//        ENUMS
// =============================
enum Role {
  admin
  owner
  tenant
}

enum PropertyType {
  house
  apartment
  studio
  room
  villa
  duplex
  penthouse
  bungalow
  chalet
  residence
  loft
  co_living
  office
  shop
  warehouse
  land
  guest_house
  hotel_room
  airbnb
}

enum Currency {
  USD
  CDF
  EUR
  GBP
}

enum PropertyStatus {
  available
  rented
  sold
}

enum PropertyPurpose {
  A_LOUER
  A_VENDRE
  SEJOUR_LIMITE
}

enum BookingStatus {
  pending
  confirmed
  cancelled
}
enum PriceUnit {
  journalier
  mensuel
  annuel
}
