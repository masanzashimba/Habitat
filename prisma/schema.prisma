generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================
//        USER MODEL
// =============================
model User {
  id                     String      @id @default(uuid())
  firstName              String?     @map("first_name")
  middleName             String?     @map("middle_name")
  lastName               String?     @map("last_name")
  email                  String      @unique
  phone                  String?     @unique
  password               String
  profileImage           String?     @map("profile_image")
  coverImage             String?     @map("cover_image")

  role                   Role        @default(owner)
  accountType            String?     @map("account_type")
  companyName            String?     @map("company_name")
  businessId             String?     @map("business_id")

  address                String?
  city                   String?     @default("Kinshasa")

  isDeleted              Boolean     @default(false)
  isActive               Boolean     @default(true)
  isEmailVerified        Boolean     @default(false)
  isPhoneVerified        Boolean     @default(false)

  passwordChangedAt      DateTime?
  lastLoginAt            DateTime?

  lockedUntil            DateTime?
  failedLoginAttempts    Int?        @default(0)

  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  // Relations
  properties             Property[]
  bookings               Booking[]
  reviews                Review[]
  favorites              Favorite[]
  refreshTokens          RefreshToken[]

  ownedTenants           Tenant[]    @relation("OwnerTenants")
  tenantProfile          Tenant?     @relation("TenantUser")

  leasesAsOwner          Lease[]     @relation("OwnerLeases")
  notifications          Notification[]

  @@map("users")
}

// =============================
//        TENANT MODEL
// =============================
model Tenant {
  id         String   @id @default(uuid())
  email      String?
  phone      String?
  firstName  String?
  lastName   String?

  ownerId    String
  owner      User     @relation("OwnerTenants", fields: [ownerId], references: [id])

  userId     String?  @unique
  user       User?    @relation("TenantUser", fields: [userId], references: [id])

  leases     Lease[]
  isActive   Boolean  @default(true)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
}

// =============================
//        PROPERTY MODEL
// =============================
model Property {
  id               String          @id @default(uuid())
  userId           String
  addressId        String

  title            String
  slug             String

  shortDescription String?
  description      String?

  propertyType     PropertyType

  price            Decimal         @db.Decimal(12, 2)
  currency         Currency        @default(USD)

  status           PropertyStatus  @default(available)
  purpose          PropertyPurpose @default(A_LOUER)

  // ✅ AJOUTE CES CHAMPS
  maxGuests        Int?
  bedrooms         Int?
  beds             Int?
  bathrooms        Int?
  kitchens         Int?
  livingRooms      Int?
  otherRooms       String?

  isFeatured       Boolean @default(false)
  isVerified       Boolean @default(false)

  discount         Decimal? @db.Decimal(5,2)
  paymentType      String?
  specialNotes     String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user             User            @relation(fields: [userId], references: [id])
  address          Address         @relation(fields: [addressId], references: [id])

  images           PropertyImage[]
  bookings         Booking[]
  reviews          Review[]
  favorites        Favorite[]
  amenities        PropertyAmenity[]
  leases           Lease[]
  priceUnit        PriceUnit       @default(MONTH)
  @@map("properties")
}

// =============================
//        PROPERTY IMAGE MODEL
// =============================
model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  imageUrl   String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_images")
}

// =============================
//        LEASE MODEL
// =============================
model Lease {
  id           String      @id @default(uuid())

  propertyId   String
  tenantId     String
  ownerId      String

  startDate    DateTime
  endDate      DateTime?

  rentAmount   Decimal     @db.Decimal(12,2)
  currency     Currency    @default(USD)
  deposit      Decimal?    @db.Decimal(12,2)

  status       LeaseStatus @default(active)
  isActive     Boolean     @default(true)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  property     Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner        User        @relation("OwnerLeases", fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("leases")
}

// =============================
//        ADDRESS MODEL
// =============================
model Address {
  id         String    @id @default(uuid())
  commune    String
  quartier   String
  avenue     String
  number     String?
  city       String    @default("Kinshasa")
  province   String    @default("Kinshasa")
  latitude   Decimal?  @db.Decimal(10, 8)
  longitude  Decimal?  @db.Decimal(11, 8)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  properties Property[]

  @@map("addresses")
}

// =============================
//        BOOKING MODEL
// =============================
model Booking {
  id           String        @id @default(uuid())
  propertyId   String
  userId       String
  startDate    DateTime
  endDate      DateTime
  status       BookingStatus @default(pending)
  totalAmount  Decimal       @db.Decimal(12, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bookings")
}

// =============================
//        REVIEW MODEL
// =============================
model Review {
  id         String   @id @default(uuid())
  propertyId String
  userId     String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// =============================
//        FAVORITE MODEL
// =============================
model Favorite {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("favorites")
}

// =============================
//        REFRESH TOKEN MODEL
// =============================
model RefreshToken {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)
  replacedBy   String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  revokedAt    DateTime?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// =============================
//        AMENITY MODEL
// =============================
model Amenity {
  id         String          @id @default(uuid())
  name       String          @unique
  properties PropertyAmenity[]
}

model PropertyAmenity {
  id         String   @id @default(uuid())
  propertyId String
  amenityId  String

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
}

// =============================
//        NOTIFICATION MODEL
// =============================
model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// =============================
//        ENUMS
// =============================
enum Role {
  admin
  owner
  tenant
}

enum PropertyType {
  house
  apartment
  studio
  room
  villa
  duplex
  penthouse
  bungalow
  chalet
  residence
  loft
  co_living
  office
  shop
  warehouse
  land
  guest_house
  hotel_room
  airbnb
}

enum Currency {
  USD
  CDF
  EUR
  GBP
}

enum PropertyStatus {
  available
  rented
  sold
}

enum PropertyPurpose {
  A_LOUER
  A_VENDRE
  SEJOUR_LIMITE
}

enum BookingStatus {
  pending
  confirmed
  cancelled
}

enum LeaseStatus {
  active
  terminated
  expired
}
enum PriceUnit {
  DAY
  MONTH
  YEAR
}