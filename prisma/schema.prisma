generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================
//        USER
// =============================
model User {
  id        String  @id @default(uuid())
  
  // =====================
  // IDENTITÉ
  // =====================
  firstName String?
  lastName  String?
  email     String  @unique
  phone     String? @unique
  profileImage String?
  coverImage   String?
  bio       String?   // petite description utilisateur
  gender    String?   // M / F / autre (ou enum si tu veux)
  birthDate DateTime?
  
  // =====================
  // COMPTE
  // =====================
  password  String
  role      Role    @default(owner)
  isActive  Boolean @default(true)
  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
  lastLoginAt DateTime?
  
  // =====================
  // ADRESSE (utile pour immobilier)
  // =====================
  country  String? @default("DRC")
  city     String? @default("Kinshasa")
  address  String?
  latitude Float?
  longitude Float?
  
  // =====================
  // BUSINESS (propriétaires / agences)
  // =====================
  companyName String?
  companyId   String? // numéro fiscal / registre commerce
  
  // =====================
  // SECURITÉ
  // =====================
  passwordChangedAt DateTime?
  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?
  
  // =====================
  // RELATIONS
  // =====================
  properties Property[]
  bookings   Booking[]
  notifications Notification[]
  ownedTenants  Tenant[] @relation("OwnerTenants")
  tenantProfile Tenant?  @relation("TenantUser")
  leasesAsOwner Lease[] @relation("OwnerLeases")
  validatedBookings Booking[] @relation("BookingValidator")
  createdContracts Contract[] @relation("ContractCreator")
  contractUser     Contract[] @relation("ContractUser")
  adminLogs AdminActionLog[]
  reviews   Review[]
  favorites Favorite[]
  refreshTokens RefreshToken[]
  
  // =====================
  // META
  // =====================
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([city])
}

// =============================
//        TENANT
// =============================
model Tenant {
  id        String  @id @default(uuid())
  firstName String?
  lastName  String?
  email     String?
  phone     String?
  
  // Informations personnelles
  profileImage    String?
  dateOfBirth     DateTime?
  nationalId      String?
  address         String?
  city            String?
  emergencyContact String?
  emergencyPhone  String?
  
  // Informations professionnelles
  occupation      String?
  employer        String?
  monthlyIncome   Float?
  
  // Statut
  isActive Boolean @default(true)

  ownerId String
  owner   User   @relation("OwnerTenants", fields: [ownerId], references: [id])

  userId String? @unique
  user   User?   @relation("TenantUser", fields: [userId], references: [id])

  bookings Booking[] @relation("TenantBookings")
  leases   Lease[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================
//        PROPERTY
// =============================
model Property {
  id      String @id @default(uuid())
  userId  String // Changed from ownerId to userId to match service
  slug    String @unique

  title            String
  shortDescription String?
  description      String?
  propertyType     PropertyType @default(APARTMENT)
  price            Decimal      @db.Decimal(12, 2)
  priceUnit        PriceUnit    @default(PER_MONTH)
  currency         Currency     @default(CDF)

  status  PropertyStatus  @default(available)
  purpose PropertyPurpose @default(A_LOUER)

  maxGuests   Int?
  bedrooms    Int?
  beds        Int?
  bathrooms   Int?
  kitchens    Int?
  livingRooms Int?
  otherRooms  String?

  securityDepositMonths Int? // Nombre de mois de garantie
  commissionMonths      Int? // Nombre de mois de commission
  commissionPercentage  Float? // Pourcentage de commission pour les ventes (0-100)
  landSize              Float? // Superficie en m² pour parcelles et maisons

  isFeatured  Boolean @default(false)
  isVerified  Boolean @default(false)
  discount    Int?
  paymentType String?
  specialNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id])
  bookings       Booking[]
  leases         Lease[]
  TemporaryBlock TemporaryBlock[]
  
  images    PropertyImage[]
  address   PropertyAddress?
  amenities PropertyAmenity[]
  reviews   Review[]
  favorites Favorite[]

  @@index([status])
  @@index([userId])
  @@index([slug])
}

// =============================
//        PROPERTY IMAGE
// =============================
model PropertyImage {
  id         String  @id @default(uuid())
  propertyId String
  imageUrl   String
  isPrimary  Boolean @default(false)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

// =============================
//        PROPERTY ADDRESS
// =============================
model PropertyAddress {
  id         String @id @default(uuid())
  propertyId String @unique

  commune   String
  quartier  String
  avenue    String
  number    String?
  city      String?
  province  String?
  latitude  Float?
  longitude Float?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// =============================
//        AMENITY
// =============================
model Amenity {
  id   String @id @default(uuid())
  name String @unique

  properties PropertyAmenity[]

  @@index([name])
}

// =============================
//        PROPERTY AMENITY
// =============================
model PropertyAmenity {
  id         String @id @default(uuid())
  propertyId String
  amenityId  String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
}

// =============================
//        REVIEW
// =============================
model Review {
  id         String @id @default(uuid())
  propertyId String
  userId     String
  rating     Int
  comment    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([propertyId, userId])
  @@index([propertyId])
}

// =============================
//        FAVORITE
// =============================
model Favorite {
  id         String @id @default(uuid())
  propertyId String
  userId     String

  createdAt DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([propertyId, userId])
  @@index([userId])
}

// =============================
//        BOOKING
// =============================
model Booking {
  id String @id @default(uuid())

  propertyId String
  userId     String?
  tenantId   String?

  startDate DateTime
  endDate   DateTime
  nights    Int

  status BookingStatus @default(pending)

  totalAmount Decimal @db.Decimal(12, 2)

  validatedById String?
  validatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id])

  user   User?   @relation(fields: [userId], references: [id])
  tenant Tenant? @relation("TenantBookings", fields: [tenantId], references: [id])

  validatedBy User? @relation("BookingValidator", fields: [validatedById], references: [id])

  lease Lease?

  @@unique([propertyId, startDate, endDate])
  @@index([propertyId, status])
}

// =============================
//        TEMP BLOCK
// =============================
model TemporaryBlock {
  id         String   @id @default(uuid())
  propertyId String
  startDate  DateTime
  endDate    DateTime
  sessionId  String
  expiresAt  DateTime

  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId, startDate, endDate])
  @@index([expiresAt])
}

// =============================
//        LEASE
// =============================
model Lease {
  id String @id @default(uuid())

  bookingId String? @unique

  propertyId String
  tenantId   String
  ownerId    String

  startDate DateTime
  endDate   DateTime?

  rentAmount Decimal  @db.Decimal(12, 2)
  currency   Currency @default(USD)
  deposit    Decimal? @db.Decimal(12, 2)

  status LeaseStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking  Booking? @relation(fields: [bookingId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  owner    User     @relation("OwnerLeases", fields: [ownerId], references: [id])

  contract Contract?
}

// =============================
//        CONTRACT
// =============================
model Contract {
  id      String @id @default(uuid())
  leaseId String @unique
  fileUrl String

  createdBy String
  userId    String?

  signedAt  DateTime?
  createdAt DateTime  @default(now())

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  creator User  @relation("ContractCreator", fields: [createdBy], references: [id])
  user    User? @relation("ContractUser", fields: [userId], references: [id])
}

// =============================
//        NOTIFICATION
// =============================
model Notification {
  id     String @id @default(uuid())
  userId String

  title   String
  message String
  type    String?
  data    Json?

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

// =============================
//        ADMIN LOG
// =============================
model AdminActionLog {
  id      String @id @default(uuid())
  adminId String

  action      String
  entityType  String
  entityId    String
  description String?

  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
}

// =============================
//        REFRESH TOKEN
// =============================
model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// =============================
//        ENUMS
// =============================
enum Role {
  admin
  owner
  tenant
}

enum PropertyType {
  APARTMENT
  HOUSE
  STUDIO
  VILLA
  OFFICE
  SHOP
  WAREHOUSE
  LAND
}

enum PropertyStatus {
  available
  reserved
  rented
}

enum PropertyPurpose {
  A_LOUER
  A_VENDRE
}

enum PriceUnit {
  PER_NIGHT
  PER_WEEK
  PER_MONTH
  PER_YEAR
  TOTAL
}

enum BookingStatus {
  pending
  confirmed
  rejected
  cancelled
}

enum LeaseStatus {
  active
  terminated
  expired
}

enum Currency {
  USD
  CDF
  EUR
}
